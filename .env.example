# Copy to .env and fill in for local runs (or export these directly).
# Kinloop reads these via os.environ — see src/kinloop/config.py.

AWS_REGION=us-east-1
KINLOOP_MODEL_ID=amazon.nova-lite-v1:0

# "local" (default, free, JSON files in sample_data/) or "dynamodb" (deployed)
KINLOOP_DATA_BACKEND=local

# "console" (default, prints to stdout), "slack", or "ses"
KINLOOP_NOTIFY_CHANNEL=console
KINLOOP_SLACK_WEBHOOK_URL=
KINLOOP_SES_SENDER=

KINLOOP_MAX_CALLS=8
